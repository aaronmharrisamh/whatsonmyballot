{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whatsonmyballot.example/schemas/ballot-1.0.0.schema.json",
  "title": "What is on my ballot — one self-contained ballot 1.0.0",
  "description": "One ballot, election, area and recommendation set. This schema validates structure. ballot-contract.js additionally validates global IDs, relationships, layout, safe content, and size limits. ballot-resources.js must validate decompressed bytes before activation. Required fields are explicit; author content and files are optional. _comment and _instructions are documentation, never executable.",
  "type": "object",
  "properties": {
    "format": {
      "const": "whatsonmyballot-ballot"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "_instructions": {
      "type": "string",
      "maxLength": 50000
    },
    "election": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "title": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "isDemo": {
          "type": "boolean"
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "date",
        "title",
        "type",
        "isDemo"
      ],
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "stateCode": {
          "type": "string",
          "maxLength": 12,
          "minLength": 1,
          "pattern": "\\S"
        },
        "county": {
          "type": "string",
          "maxLength": 1000
        },
        "municipality": {
          "type": "string",
          "maxLength": 1000
        },
        "precinct": {
          "type": "string",
          "maxLength": 1000
        },
        "districts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "\\S"
              },
              "_comment": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "state",
        "stateCode",
        "county",
        "municipality",
        "precinct",
        "districts"
      ],
      "additionalProperties": false
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "_comment": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "^https://",
            "format": "uri"
          },
          "attachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "_comment": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "attachmentId"
            ]
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "partisan",
              "nonpartisan",
              "proposals",
              "other"
            ]
          },
          "_comment": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "title",
          "category"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "contestIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 1000,
                  "uniqueItems": true
                },
                "_comment": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "id",
                "contestIds"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          },
          "_comment": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "label",
          "columns"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "contests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contest"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "_comment": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "id",
    "title",
    "revision",
    "election",
    "area",
    "groups",
    "pages",
    "contests"
  ],
  "additionalProperties": false,
  "$defs": {
    "details": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 20000
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "markdown": {
          "type": "string",
          "maxLength": 200000
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "opinion": {
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "authorId",
        "text"
      ],
      "additionalProperties": false
    },
    "headerOpinion": {
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        },
        "highlighted": {
          "type": "boolean"
        },
        "color": {
          "enum": [
            "red",
            "orange",
            "yellow",
            "green",
            "blue",
            "gray"
          ]
        }
      },
      "required": [
        "authorId",
        "text"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "candidate",
            "party",
            "choice",
            "write-in"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "party": {
          "type": "string",
          "maxLength": 200
        },
        "photoAttachmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "website": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "^https://",
          "format": "uri"
        },
        "details": {
          "$ref": "#/$defs/details"
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "mark": {
              "enum": [
                "this",
                "or",
                "none"
              ]
            },
            "color": {
              "enum": [
                "red",
                "orange",
                "yellow",
                "green",
                "blue",
                "gray"
              ]
            },
            "_comment": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "mark",
            "color"
          ],
          "additionalProperties": false
        },
        "opinion": {
          "$ref": "#/$defs/opinion"
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "contest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 1000
        },
        "kind": {
          "enum": [
            "candidate",
            "straight-party",
            "proposal",
            "retention"
          ]
        },
        "maxSelections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "instructions": {
          "type": "string",
          "maxLength": 20000
        },
        "details": {
          "$ref": "#/$defs/details"
        },
        "opinion": {
          "$ref": "#/$defs/headerOpinion"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "groupId",
        "title",
        "kind",
        "maxSelections",
        "instructions",
        "options"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "fileName": {
          "type": "string",
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[^\\\\/\\u0000-\\u001f]+$"
        },
        "mimeType": {
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            "text/plain",
            "text/markdown"
          ]
        },
        "encoding": {
          "const": "gzip-base64"
        },
        "data": {
          "type": "string",
          "minLength": 4,
          "maxLength": 34952536,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "uncompressedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "_comment": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "fileName",
        "mimeType",
        "encoding",
        "data",
        "uncompressedBytes",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
